DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=erp_platform
DB_USER=erp
DB_PASSWORD=erp
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# AI assistant (technical.md §8.8). AI_LLM_PROVIDER is "mistral" (default)
# or "anthropic"; set the key for the one you use. Leave the key blank to
# run with the assistant in its "not configured" state (REQ-CORE-AI-009).
# AI_LLM_MODEL is optional -- blank uses the provider's default
# (mistral-large-latest / claude-sonnet-5).
AI_LLM_PROVIDER=mistral
MISTRAL_API_KEY=
AI_LLM_MODEL=mistral-large-latest
ANTHROPIC_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
