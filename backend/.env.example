DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=erp_platform
DB_USER=erp
DB_PASSWORD=erp
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# AI Chat Layer (technical.md §8.8) -- leave blank to run with the AI
# assistant in its "not configured" degraded state (REQ-CORE-AI-009).
ANTHROPIC_API_KEY=
AI_LLM_MODEL=claude-sonnet-5

CORS_ALLOWED_ORIGINS=http://localhost:5173
